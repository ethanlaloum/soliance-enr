# Lead forms post to /api/lead.php, which mails through Resend; its key and sender live
# in the root .env (see ../../.env.example), never here.
# Google Search Console HTML-tag verification token (content of the meta tag)
VITE_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-XXXXXXXXXX); loaded only after the visitor accepts audience measurement
VITE_GA_MEASUREMENT_ID=
