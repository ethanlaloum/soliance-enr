# HubSpot Forms API targets. Without the portal id and a form id, the matching form
# shows the NOT_CONFIGURED message and sends nothing.
VITE_HUBSPOT_PORTAL_ID=
# "Demander une étude gratuite" (home page and product pages)
VITE_HUBSPOT_STUDY_REQUEST_FORM_ID=
# Professionnels page form
VITE_HUBSPOT_PROFESSIONAL_FORM_ID=
# Parrainage page form
VITE_HUBSPOT_REFERRAL_FORM_ID=
# Simulateur lead capture
VITE_HUBSPOT_SIMULATION_FORM_ID=
# Soliance Care page form (subscription, health check, takeover, claim, pro, installer demo)
# Contact properties: full_name, phone, zip, email, care_request_type, inverter_brand, installation_situation
VITE_HUBSPOT_CARE_FORM_ID=
# Google Search Console HTML-tag verification token (content of the meta tag)
VITE_GOOGLE_SITE_VERIFICATION=
